{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "gdb",
            "request": "attach",
            "name": "LunaixOS",
            "executable": "${workspaceRoot}/build/bin/lunaix.bin",
            "target": ":1234",
            "remote": true,
            "cwd": "${workspaceRoot}",
            "valuesFormatting": "parseText",
            "preLaunchTask": "Launch LunaixOS"
        }
    ]
}
